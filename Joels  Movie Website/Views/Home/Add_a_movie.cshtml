@model Movie

@{ViewData["Title"] = "Add_a_movie";
}
<h1>@ViewData["Title"]</h1>

<form method="post">
    
    <input type = "hidden", asp-for="MovieId"/>
    
    <select asp-for="CategoryId">
        <option value = "">Select a Category</option>
        @foreach (Category c in ViewBag.Categories)
        {
            <option value = "@c.CategoryId">@c.CategoryName</option>
        }
    </select>
    
    <br />
    <label>Title</label>
    <input asp-for="Title" type="text" name="title" required />
    <br />
    <label>Year</label>
    <input asp-for="Year" type="text" name="year" required />
    <br />
    <label>Director</label>
    <input asp-for="Director"  type="text" name="director" required />
    <br />
    <label>Rating</label>
    <select asp-for="Rating" name="rating" required>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select >
    <br />
    <label>Edited</label>
    <select asp-for="Edited" name="edited">
        <option value="Yes">Yes</option>
        <option value="No">No</option>
    </select>
    <br />
    <label>Lent to:</label>
    <input asp-for="LentTo" type="text" name="lent_to" />
    <br />
    <label>Notes</label>
    <input asp-for="Notes" type="text" name="notes" maxlength="25" />
    <br />
    <button type="submit">Submit</button>

</form>
