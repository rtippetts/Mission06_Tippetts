@model Movie

@{ViewData["Title"] = "Add_a_movie";
}
<h1>@ViewData["Title"]</h1>

<form method="post">
    
    <input type = "hidden" asp-for="MovieId"/>
        
    <select asp-for="CategoryId" required>
        <option value = "">Select a Category</option>
        @foreach (Category c in ViewBag.Categories)
        {
            <option value = "@c.CategoryId">@c.CategoryName</option>
        }
    </select>
    
    <br />
    <label>Title</label>
    <input asp-for="Title" type="text" name="title" required/>
    <br />
    
    <label>Year</label>
    <input asp-for="Year" type="number" name="year" min="1888" required />
    

    <br />
    <label>Director</label>
    <input asp-for="Director" type="text" name="director" required />
    <br />
    
    
    <label>Rating</label>
    <select asp-for="Rating" required>
        <option value="">Select a Rating</option>
        @foreach (string rating in ViewBag.Ratings)
        {
            <option value="@rating">@rating</option>
        }
    </select>
    
    
    <br />

    
    <label>Edited</label>
    <select asp-for="Edited" name="edited" required>
        <option value="">Select an Option</option>  <!-- Ensure there's no blank option passed -->
        <option value="1">Yes</option>
        <option value="0">No</option>
    </select>


    <br />

    <label>Lent to:</label>
    <input asp-for="LentTo" type="text" name="lent_to" />
    <br />

   
    <label>Copied to Plex</label>
    <select asp-for="CopiedToPlex" name="copiedToPlex" required>
        <option value="">Select an Option</option>  <!-- Ensure there's no blank option passed -->
        <option value="1">Yes</option>
        <option value="0">No</option>
    </select>

    <br />

    <label>Notes</label>
    <input asp-for="Notes" type="text" name="notes" maxlength="25" />
    <br />
    <button type="submit">Submit</button>

</form>
